<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Acs.Acr122u.Sample</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>

    <!--
      CA2007 ("consider ConfigureAwait(false)") exists to prevent deadlocks in code that resumes
      on a captured SynchronizationContext (classic ASP.NET, WPF/WinForms UI threads, etc.). A
      top-level-statements console app has no such context, so ConfigureAwait(false) here would
      be pure noise with no behavioral effect - suppressed for this executable only; the library
      itself (Acs.Acr122u.csproj) correctly keeps the rule enabled and calls ConfigureAwait(false)
      throughout.
    -->
    <NoWarn>$(NoWarn);CA2007</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Acs.Acr122u/Acs.Acr122u.csproj" />
  </ItemGroup>

</Project>
